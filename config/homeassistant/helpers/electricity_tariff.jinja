{#- State template of the UI helper "Stromtarif aktuell" (Template → Sensor,
    sensor.electricity_tariff, no unit, not exposed to Assist): supplier and
    product of the active tariff slot, for example "Stadtwerke · Ökostrom".
    The recorder keeps its history, so every period can be matched to the
    contract that was valid then (for a later tariff comparison or a
    supplier API).

    The active slot follows the same rule as electricity_work_price.jinja.
    Per slot: input_text.electricity_tariff_N_provider (supplier) and
    input_text.electricity_tariff_N_product (product name). A slot without
    names reads "Tarif N". docs/smart_meter.md, section "Tariff". -#}
{%- set ns = namespace(start='', value=none) -%}
{%- set today = now().date() | string -%}
{%- for i in range(1, 4) -%}
  {%- set start = states('input_datetime.electricity_tariff_' ~ i ~ '_valid_from') -%}
  {%- set work = states('input_number.electricity_tariff_' ~ i ~ '_work_price') | float(0) -%}
  {%- if work > 0 and start is match('[0-9]{4}-[0-9]{2}-[0-9]{2}$') and start <= today and start > ns.start -%}
    {%- set ns.start = start -%}
    {#- A namespace: a plain `set` inside the inner loop would not leave it. -#}
    {%- set names = namespace(parts=[]) -%}
    {%- for part in ['provider', 'product'] -%}
      {%- set v = states('input_text.electricity_tariff_' ~ i ~ '_' ~ part) | trim -%}
      {%- if v and v not in ['unknown', 'unavailable'] -%}{%- set names.parts = names.parts + [v] -%}{%- endif -%}
    {%- endfor -%}
    {%- set ns.value = names.parts | join(' · ') if names.parts else 'Tarif ' ~ i -%}
  {%- endif -%}
{%- endfor -%}
{{ ns.value if ns.value is not none else none }}
