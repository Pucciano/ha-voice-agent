# Global settings
TZ=Europe/Berlin

# vLLM defaults
VLLM_MODEL_PATH=/models/llm/Qwen2.5-7B-Instruct
VLLM_SERVED_MODEL_NAME=qwen2.5-7b-instruct
VLLM_DTYPE=half
VLLM_KV_CACHE_DTYPE=fp8
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=1
VLLM_SWAP_SPACE=24
VLLM_CPU_OFFLOAD_GB=0
VLLM_GPU_MEMORY_UTILIZATION=0.96
VLLM_TOOL_CALL_PARSER=hermes
VLLM_CHAT_TEMPLATE_CONTENT_FORMAT=string
VLLM_ENABLE_AUTO_TOOL_CHOICE=true

# Development proxy
LLM_PROXY_PORT=18001
LLM_PROXY_LOG_LEVEL=INFO
LLM_PROXY_ENABLE_CAPTURE=true
LLM_PROXY_CAPTURE_DIR=/datasets/llm
LLM_PROXY_MAX_REPAIR_RETRIES=1
LLM_PROXY_UPSTREAM_TIMEOUT_SECONDS=600

# STT/TTS defaults
STT_MODEL=/models/stt/large-v3-ct2
STT_LANGUAGE=en
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
TTS_VOICE=en_US-lessac-medium

# Host paths
PROD_MODELS_DIR=/opt/ha-voice/models
PROD_CACHE_DIR=/opt/ha-voice/cache
