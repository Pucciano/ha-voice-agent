# Copy to secrets.yaml (gitignored) and fill in real values.
#
# Generate one API key per satellite with:
#   openssl rand -base64 32
# The key also encrypts OTA uploads, so there is no separate OTA password.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

living_room_api_key: "BASE64_32_BYTE_KEY"
