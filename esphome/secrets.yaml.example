# Copy to secrets.yaml (gitignored) and fill in real values.
#
# Generate one API key per satellite with:
#   openssl rand -base64 32
# The key also encrypts OTA uploads, so there is no separate OTA password.

wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"

living_room_api_key: "BASE64_32_BYTE_KEY"

# Wake word recorder on the Jetson (docs/jetson_setup.md, section 10): its IP
# address, and a token shared with WAKE_WORD_RECORDER_TOKEN in the Jetson's
# compose .env, generated with:
#   openssl rand -hex 24
wake_word_recorder_host: "CHANGE_ME"
wake_word_recorder_token: "CHANGE_ME"
